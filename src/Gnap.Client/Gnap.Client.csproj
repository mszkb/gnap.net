<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Gnap.Client</PackageId>
    <Description>A GNAP (RFC 9635) client for .NET: AS discovery, httpsig-signed grant requests, redirect and user-code interaction with finish-hash verification, continuation and polling, token rotation, revocation and key rotation, plus IHttpClientFactory/DI integration. No ASP.NET Core dependency.</Description>
    <PackageTags>gnap;rfc9635;authorization;client</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gnap.Core\Gnap.Core.csproj" />
    <ProjectReference Include="..\Gnap.HttpMessageSignatures\Gnap.HttpMessageSignatures.csproj" />
  </ItemGroup>

</Project>
