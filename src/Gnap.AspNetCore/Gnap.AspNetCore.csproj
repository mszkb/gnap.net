<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Gnap.AspNetCore</PackageId>
    <Description>GNAP (RFC 9635) for ASP.NET Core: an embeddable authorization server (grant, continuation and interaction endpoints, key-bound and bearer token issuance with token management, RFC 9767 introspection and resource registration, pluggable policy, storage and token formats) and resource server middleware (Authorization: GNAP token verification with httpsig key proofs, introspection with caching or local verification, access-right authorization policies).</Description>
    <PackageTags>gnap;rfc9635;rfc9767;authorization-server;resource-server;aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gnap.Core\Gnap.Core.csproj" />
    <ProjectReference Include="..\Gnap.HttpMessageSignatures\Gnap.HttpMessageSignatures.csproj" />
    <ProjectReference Include="..\Gnap.HttpMessageSignatures.AspNetCore\Gnap.HttpMessageSignatures.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gnap.AspNetCore.Tests" />
  </ItemGroup>

</Project>
