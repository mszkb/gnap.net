<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-implementation interoperability tests (Phase 5). Every test is skipped
    unless its peer is configured through environment variables (see
    docs/interop.md); `interop/run-*.sh` and the Interop workflow set them up.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gnap.AspNetCore\Gnap.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Gnap.Client\Gnap.Client.csproj" />
    <ProjectReference Include="..\..\src\Gnap.Core\Gnap.Core.csproj" />
    <ProjectReference Include="..\..\src\Gnap.HttpMessageSignatures\Gnap.HttpMessageSignatures.csproj" />
  </ItemGroup>

</Project>
