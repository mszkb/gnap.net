{
  "stryker-config": {
    "solution": "Gnap.sln",
    "project": "Gnap.HttpMessageSignatures.csproj",
    "test-projects": [
      "tests/Gnap.HttpMessageSignatures.Tests/Gnap.HttpMessageSignatures.Tests.csproj"
    ],
    "mutate": [
